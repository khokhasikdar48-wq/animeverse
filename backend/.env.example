# Backend environment variables example
DATABASE_URL=postgresql://postgres:postgres@db:5432/animeverse
JWT_ACCESS_SECRET=replace_this
JWT_REFRESH_SECRET=replace_this
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=demo@animeverse.local
ADMIN_INVITE_TOKEN=__USE_INVITE_FLOW__
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
